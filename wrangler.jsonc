// Réglage Cloudflare : le site est un ensemble de fichiers statiques (dossier dist/).
// "single-page-application" renvoie index.html pour toute adresse inconnue
// (ex. /jouer/ABC123), pour que React affiche la bonne page.
{
  "name": "revolia-live",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
